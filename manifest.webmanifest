{
 "name": "GéoTorche",
 "short_name": "GéoTorche",
 "lang": "fr",
 "description": "Des fichiers cachés dans le monde réel, révélés par la torche.",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "portrait",
 "background_color": "#0c0d10",
 "theme_color": "#0c0d10",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any maskable"
  }
 ],
 "share_target": {
  "action": "./partage",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "files": [
    {
     "name": "capsule",
     "accept": [
      "text/plain",
      ".txt",
      ".gtch",
      ".json",
      "application/json",
      "application/octet-stream"
     ]
    }
   ]
  }
 }
}